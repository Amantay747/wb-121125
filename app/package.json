{
    "name": "wb-tariffs-service",
    "version": "1.0.0",
    "type": "module",
    "description": "Сервис для получения тарифов WB сохранения в PostgreSQL и выгрузки в Google Sheets",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpite-only src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "migrate": "knex --knexfile knexfile.ts migrate:latest",
        "rollback": "knex --knexfile knexfile.ts migrate:rollback",
        "seed": "knex --knexfile knexfile.ts seed:run"
    },
    "dependencies": {
        "axios": "^1.5.0",
        "dayjs": "^1.11.13",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "ioredis": "^5.3.1",
        "knex": "^3.1.0",
        "pg": "^8.11.2",
        "googleapis": "^133.0.0",
        "node-cron": "^3.0.2",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.5.1",
        "@types/morgan": "^1.9.4",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.2.2"
    },
    "starts": {
        "start": "node index.ts"
    },
    "keywords": [],
    "author": "pavelG",
    "license": "ISC"
}